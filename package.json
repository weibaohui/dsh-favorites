{
  "name": "@weibaohui/dsh-favorites",
  "version": "0.1.1",
  "description": "dsh 插件 · 会话收藏夹：左侧会话行收藏/星标，收藏夹主面板支持文件夹分门别类、备注、自定义显示名、继续会话、Fork 新会话、会话基本统计与 fork 关系图。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "favorites",
    "bookmarks",
    "sessions",
    "fork-graph"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.15",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weibaohui/dsh-favorites.git"
  },
  "homepage": "https://github.com/weibaohui/dsh-favorites#readme",
  "bugs": {
    "url": "https://github.com/weibaohui/dsh-favorites/issues"
  },
  "scripts": {
    "check": "node --check src/index.js && node --check client/index.js",
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "verify:storage": "node scripts/verify-storage-roundtrip.mjs",
    "prepublishOnly": "npm run build:client && npm run check && npm test"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
